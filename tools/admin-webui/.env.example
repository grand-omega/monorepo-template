# Backend that the dev server proxies /admin/api/* to.
VITE_API_URL=http://localhost:8080

# Used for openapi:fetch script to point at a live spec.
API_URL=http://localhost:8080

# Injected at build time; tagged on Sentry releases (when wired up).
VITE_GIT_SHA=

# Playwright base URL when E2E targets something other than the dev server.
E2E_BASE_URL=http://localhost:5173

# Optional: enables backend-backed login/logout Playwright tests.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional: enables user action Playwright tests. Use a non-admin disposable user.
E2E_TARGET_EMAIL=
