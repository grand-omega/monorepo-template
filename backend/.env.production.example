# Production example. Copy into your secret/config system; do not commit real values.

APP_ENV=prod
APP_BIND_ADDR=0.0.0.0:8080
APP_METRICS_BIND_ADDR=0.0.0.0:9090
APP_PUBLIC_BASE_URL=https://api.example.com/

APP_DATABASE_URL=postgres://app:REPLACE_ME@postgres.example.com:5432/app?sslmode=require
APP_DATABASE_MAX_CONNECTIONS=20
APP_REDIS_URL=rediss://:REPLACE_ME@redis.example.com:6379
APP_MIGRATE_ON_START=false

APP_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
APP_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
APP_JWT_KID=prod-2026-01
APP_JWT_ISSUER=lab-rust-server
APP_JWT_AUDIENCE=mobile
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=30d
# Optional. JSON array of verify-only public keys retained during key rotation.
# APP_JWT_PREVIOUS_PUBLIC_KEYS=[{"kid":"prod-2025-12","public_key_pem":"-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----\n"}]

APP_SMTP_URL=smtps://user:REPLACE_ME@smtp.example.com:465
APP_SMTP_FROM=no-reply@example.com
APP_SMTP_FROM_NAME=Lab Rust Server
APP_ALLOW_NOOP_MAILER=false

APP_ARGON2_M_COST=19456
APP_ARGON2_T_COST=2
APP_ARGON2_P_COST=1

APP_LOGIN_MAX_FAILURES=10
APP_LOGIN_LOCK_DURATION=15m

APP_CORS_ALLOWED_ORIGINS=https://app.example.com
APP_TRUSTED_PROXY_CIDRS=10.0.0.0/8

APP_WEBAUTHN_RP_ID=admin.example.com
APP_WEBAUTHN_RP_ORIGIN=https://admin.example.com
APP_WEBAUTHN_RP_NAME=Admin Console

APP_LOG_FORMAT=json
APP_LOG=info,sqlx=warn,tower_http=info,hyper=warn
