# Lab Rust Server — example environment file.
# Copy to .env.local and fill in JWT keys (see `make keys`).

# --- runtime --------------------------------------------------------------
APP_ENV=dev                         # dev | test | prod
APP_BIND_ADDR=0.0.0.0:8080
APP_METRICS_BIND_ADDR=0.0.0.0:9090
APP_PUBLIC_BASE_URL=http://localhost:8080/

# --- persistence ----------------------------------------------------------
APP_DATABASE_URL=postgres://app:app@localhost:5432/app
APP_DATABASE_MAX_CONNECTIONS=10
APP_REDIS_URL=redis://localhost:6379
APP_MIGRATE_ON_START=true

# --- jwt (Ed25519 PEM) ----------------------------------------------------
# Generate with: make keys
APP_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APP_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
APP_JWT_KID=dev-1
APP_JWT_ISSUER=lab-rust-server
APP_JWT_AUDIENCE=mobile
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=30d

# --- smtp -----------------------------------------------------------------
# Use mailhog (smtp://mailhog:1025) in compose, or a real SMTP relay in prod.
APP_SMTP_URL=smtp://localhost:1025
APP_SMTP_FROM=no-reply@example.test
APP_SMTP_FROM_NAME=Lab Rust Server
# Set to true ONLY in dev/test to allow startup if SMTP init fails.
# In prod, leaving this unset will cause startup to fail loudly instead of
# silently dropping verification/reset emails.
APP_ALLOW_NOOP_MAILER=false

# --- password hashing (Argon2id) ------------------------------------------
# OWASP minimums for prod: m=19456, t=2, p=1. Lower values rejected at startup.
APP_ARGON2_M_COST=19456             # memory in KiB
APP_ARGON2_T_COST=2                 # iterations
APP_ARGON2_P_COST=1                 # parallelism

# --- auth policy ----------------------------------------------------------
APP_LOGIN_MAX_FAILURES=10
APP_LOGIN_LOCK_DURATION=15m

# --- networking -----------------------------------------------------------
# Comma-separated. Leave empty to disable CORS.
APP_CORS_ALLOWED_ORIGINS=
# CIDRs trusted to set X-Forwarded-For. Leave empty if app is internet-facing.
APP_TRUSTED_PROXY_CIDRS=

# --- observability --------------------------------------------------------
APP_LOG_FORMAT=pretty               # pretty | json
APP_LOG=info,sqlx=warn,tower_http=info,hyper=warn
